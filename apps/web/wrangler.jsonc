{
  // Static-assets-only Worker serving the built PWA at s.gamestao.com (no Worker script).
  //   pnpm --filter @sudoku/web build
  //   pnpm --filter @sudoku/web cf:deploy
  // custom_domain makes the first deploy create the DNS record and edge certificate.
  // Cache headers live in public/_headers (copied into dist/ by Vite).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sudoku-web",
  // Lets CI deploy with just an API token (no OAuth login, no account lookup).
  "account_id": "e64b61f1629ebcc49ee9b6eea2a95b82",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "s.gamestao.com", "custom_domain": true }],
  // No Worker script, so the *.workers.dev and preview URLs would only duplicate the site.
  "workers_dev": false,
  "preview_urls": false,
}
