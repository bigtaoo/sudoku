{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sudoku/web", "dev"],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sudoku/web", "preview", "--port", "4173", "--strictPort"],
      "port": 4173
    },
    {
      "name": "server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sudoku/server", "dev"],
      "port": 8787
    },
    {
      "name": "web-cf",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@sudoku/web", "exec", "wrangler", "dev", "--port", "8799"],
      "port": 8799
    }
  ]
}
